{
    "id": "cloudflaretunnel",
    "module": "cloudflaretunnel",
    "name": "Cloudflare Tunnel",
    "display_name": "Cloudflare Tunnel",
    "version": "1.0.0",
    "author": "demo",
    "homepage": "https://www.koolcenter.com",
    "category": 2,
    "category_name": "穿透",
    "description": "Cloudflare Tunnel 内网穿透插件，通过 Token 远程管理隧道将局域网服务安全暴露到公网，无需公网 IP。",
    "depends": "2",
    "depends_desc": "需要 Entware 环境（/opt 可用，cloudflared 由 opkg 安装）",
    "web_page": "Module_cloudflaretunnel.asp",
    "service_script": "scripts/cloudflaretunnel.sh",
    "dbus_prefix": "cloudflaretunnel",
    "dbus": [
        { "key": "cloudflaretunnel_enable",   "default": "0",     "desc": "开机自启与插件总开关 0/1" },
        { "key": "cloudflaretunnel_mode",     "default": "remote","desc": "隧道模式 remote=Token / local=config.yml" },
        { "key": "cloudflaretunnel_token",    "default": "",      "desc": "远程管理隧道 Token（敏感）" },
        { "key": "cloudflaretunnel_name",     "default": "",      "desc": "本地管理隧道名称（local 模式）" },
        { "key": "cloudflaretunnel_loglevel", "default": "info",  "desc": "日志级别 debug/info/warn/error" },
        { "key": "cloudflaretunnel_extra",    "default": "",      "desc": "附加启动参数" }
    ],
    "changelog": [
        { "version": "1.0.0", "desc": "首个 softcenter 版本：Token 远程隧道、启停、状态、日志、Web 管理页。" }
    ]
}
